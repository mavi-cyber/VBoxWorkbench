<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VBoxWorkbench.Core\VBoxWorkbench.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>0.1.3</Version>
    <Product>VBox Workbench</Product>
    <Description>A graphical front end for VBoxManage</Description>
    <Copyright>Copyright (C) 2026 mavi-cyber. Licensed under GPL-3.0.</Copyright>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\app.ico" Link="Assets\app.ico" />
    <Resource Include="..\..\assets\logo.png" Link="Assets\logo.png" />
  </ItemGroup>

</Project>
